# Supabase — required for production mode (omit or leave placeholder for demo mode)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key

# Do NOT put service role or Resend keys in the frontend env.
#
# ── Auth emails (signup confirm, password reset) ─────────────────────────────
# Supabase built-in mail hits "email rate limit exceeded" quickly (~4/hour).
# Configure custom SMTP so verification emails actually arrive:
#
#   1. resend.com → API Keys → create key (re_...)
#   2. resend.com → Domains → verify your domain (or for quick test: verify
#      nexuservice@gmail.com under Emails → add, use sender onboarding@resend.dev)
#   3. Supabase Dashboard → Project Settings → Authentication → SMTP Settings:
#        Enable custom SMTP
#        Host: smtp.resend.com
#        Port: 465
#        Username: resend
#        Password: <your Resend API key>
#        Sender email: onboarding@resend.dev  (test) or noreply@yourdomain.com
#        Sender name: NexEstate
#   4. Authentication → Providers → Email → keep "Confirm email" ON
#   5. Wait ~1 hour after rate-limit errors before testing again (or use SMTP first)
#
# Edge Function secrets (separate from Auth SMTP):
#   supabase secrets set RESEND_API_KEY=re_xxx
#   supabase secrets set RESEND_FROM_EMAIL="NexEstate <noreply@yourdomain.com>"
#   supabase secrets set APP_URL=https://your-app-domain.com
#
# Deploy functions:
#   supabase functions deploy send-email
#   supabase functions deploy notify-share
#   supabase functions deploy generate-agreement-pdf
#   supabase functions deploy complete-signing
#   supabase functions deploy get-signing-link
#
# Storage buckets (must match schema.sql v2):
#   property-images — public read, authenticated upload
#   signed-contracts — private; PDFs uploaded by service role
