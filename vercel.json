{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.nexestate.co" }],
      "destination": "https://nexestate.co/:path*",
      "statusCode": 308
    }
  ]
}
